# Matchpiece Environment Configuration Example
# Copy this file to .env and configure your environment variables.
# NEVER commit .env to version control or expose API keys in client-side code.

# Server-Side API Key for Gemma 4 open-weight model (gemma-4-31b-it)
# The key is strictly read by server.ts and never sent to browser code.
GEMINI_API_KEY="YOUR_API_KEY_HERE"

# Admin Dashboard Passcode (required for /admin access)
# Never exposed to client-side code.
ADMIN_CODE="change-me"

# Demo Mode Setting: set to "true" to load sample members, "false" for clean production
DEMO_MODE="false"

# Local Server Port (default: 3000)
PORT=3000

# Public or deployment URL (e.g., https://matchpiece.ai.studio or Cloud Run URL)
APP_URL="http://localhost:3000"

# Optional Gmail SMTP configuration for event RSVP confirmation emails (silently disabled if omitted)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Optional sender address (e.g. a Brevo-verified domain). Falls back to SMTP_USER when empty.
# Port 465 uses TLS; 587 uses STARTTLS.
EMAIL_FROM=""
# Optional Reply-To for event emails that have no contact email. Falls back to EMAIL_FROM, then SMTP_USER.
# An address ending in smtp-brevo.com is never used as Reply-To.
# EMAIL_REPLY_TO=""

# Ticket & Self Check-in HMAC Secret (64 random hex chars; set as a Cloud Run secret)
TICKET_HMAC_SECRET=""

# Base URL for share links, event pages, OG tags, calendar files and emails.
# Defaults to https://matchpiece.ai.studio when not set.
PUBLIC_SHARE_URL=""

# Old public hosts (comma separated) whose page requests get a 301 to PRIMARY_URL.
# Set only on the service behind the old address. API calls, sw.js, the manifest,
# OG images and static files are not redirected.
LEGACY_HOSTS=""
PRIMARY_URL="https://matchpiece.ai.studio"
